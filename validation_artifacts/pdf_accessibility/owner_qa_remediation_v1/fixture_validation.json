    "status": "EXPERIMENTAL_CANDIDATE",
    "output": "tmp\\pdf_accessibility\\owner_qa_remediation_v1\\batches\\batch1_high\\revisions\\fc6bdef0fdc4cb5fa2e6b1e819126f8bf94aef4df1b32c6cf93394deed2cc46f\\after\\MACRO-20.pdf",
