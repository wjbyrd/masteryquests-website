{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "masteryquests-econnections-classroom",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "masteryquests.org/api/econnections-classroom/*", "zone_name": "masteryquests.org" }, { "pattern": "www.masteryquests.org/api/econnections-classroom/*", "zone_name": "masteryquests.org" }],
  "d1_databases": [{ "binding": "CLASSROOM_DB", "database_name": "econnections-classroom", "database_id": "REPLACE_WITH_DEDICATED_D1_ID", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "CLASSROOM_RATE", "namespace_id": "1101", "simple": { "limit": 120, "period": 60 } },
    { "name": "CLASSROOM_GLOBAL_RATE", "namespace_id": "1102", "simple": { "limit": 3000, "period": 60 } }
  ],
  "vars": { "ALLOWED_ORIGINS": "https://masteryquests.org,https://www.masteryquests.org", "RETENTION_DAYS": "730" },
  "observability": { "enabled": false },
  "triggers": { "crons": ["23 5 * * *"] }
}
